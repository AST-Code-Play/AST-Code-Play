# Copiar este archivo a .env y completar con los datos reales de la base de datos.

# Opción A: una sola URL de conexión (recomendado en producción / Docker)
# DATABASE_URL=postgresql://usuario:password@localhost:5432/ast_code_play

# Opción B: variables individuales (si no se define DATABASE_URL)
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=postgres
PGDATABASE=ast_code_play

PORT=3001
